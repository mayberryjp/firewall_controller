{
  "name": "firewall-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --port 3030",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.0",
    "ipaddr.js": "^2.2.0",
    "lossless-json": "^4.3.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "vuetify": "^3.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^2.2.0"
  }
}
